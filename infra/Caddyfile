{$DOMAIN} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
    Strict-Transport-Security "max-age=31536000"
    -Server
  }
  handle /api/* {
    reverse_proxy api:8080 {
      flush_interval -1
    }
  }
  handle /healthz {
    reverse_proxy api:8080
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
