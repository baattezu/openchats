# make init creates .env with unique development secrets.
DATABASE_URL=postgres://messaging:CHANGE_ME@localhost:5436/messaging?sslmode=disable
POSTGRES_PASSWORD=CHANGE_ME
ENCRYPTION_KEY=BASE64_OF_32_RANDOM_BYTES
API_ADDR=:8002
PUBLIC_URL=http://localhost:5175
MEDIA_DIR=./data/media
# Operator opt-in, plus user risk acknowledgement, are both required.
ENABLE_WHATSAPP_WEB=false
WA_SEND_INTERVAL_SECONDS=15
STOP_ALL_SENDS=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
META_APP_ID=
META_APP_SECRET=
META_SIGNUP_CONFIG_ID=
META_GRAPH_VERSION=v25.0
# Instagram Login credentials from the Instagram product setup
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=RANDOM_SECRET
# Production only
DOMAIN=messaging.example.com
